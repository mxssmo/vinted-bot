# Required: configure at least one bot and its destination chat.
TELEGRAM_BOT_TOKEN_1=
TELEGRAM_CHAT_ID_1=

# Optional second bot (leave both blank to disable).
TELEGRAM_BOT_TOKEN_2=
TELEGRAM_CHAT_ID_2=

# Optional administrator for group chats or a different private-chat owner.
# TELEGRAM_ADMIN_USER_ID=

# Optional storage paths (defaults are shown).
# DELIVERY_DB_PATH=data/deliveries.sqlite
# DELIVERY_BACKUP_DIR=data/backups
